# Copy to .env for docker compose. .env is gitignored; do not commit real
# secrets. Nothing in the Python code reads .env — these are consumed by
# docker-compose.yml only, with sensible defaults if unset.

# --- Docker: Postgres credentials ------------------------------------------
# Dev defaults. Change before pointing this at a shared host.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=desakota
POSTGRES_PORT=5432

# --- Docker: Jupyter --------------------------------------------------------
JUPYTER_PORT=8888

# --- Inside-container data root --------------------------------------------
# Where the data tree (raw/interim/processed) lives inside the container.
# Leave this as /workspace/data so the bind-mount lines up.
DESAKOTA_DATA_DIR=/workspace/data

# --- Host-side data root (optional, Python code only) ----------------------
# Only consulted when running Python *outside* the container (e.g. your WSL
# shell). Point it at ext4 if the repo sits on /mnt/c, where file access is
# slow. Not read by docker-compose.
# DESAKOTA_DATA_DIR=~/data/desakota

# --- Earth Observation Group (EOG) login -----------------------------------
# Needed only once VIIRS nighttime lights enter the pipeline (a later phase,
# not used now). Register at https://eogdata.mines.edu/products/register/
# EOG_USERNAME=
# EOG_PASSWORD=
