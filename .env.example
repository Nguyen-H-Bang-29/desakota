# Nothing in this repo loads a .env file. Export these in your shell profile
# (or with direnv) for them to take effect.

# Where the data tree (raw/interim/processed) lives. Unset = data/ in the repo.
# Point it at ext4 if the repo sits on /mnt/c, where file access is slow.
# DESAKOTA_DATA_DIR=~/data/desakota

# Earth Observation Group (EOG) login, needed only once VIIRS nighttime lights
# enter the pipeline (a later phase, not used now).
# Register at https://eogdata.mines.edu/products/register/
# EOG_USERNAME=
# EOG_PASSWORD=
